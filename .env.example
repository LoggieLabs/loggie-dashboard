# Server Configuration
PORT=3000
NODE_ENV=production

# Node identity (shown in header)
NODE_NAME=mynode
NETWORK_NAME=Sepolia

# IPFS (default: enabled, API on localhost:5001)
ENABLE_IPFS=true
IPFS_API=http://127.0.0.1:5001

# Ethereum clients — set ENABLE_* to false to disable entirely
ENABLE_GETH=false
GETH_RPC=http://127.0.0.1:8545

ENABLE_LIGHTHOUSE=false
LIGHTHOUSE_API=http://127.0.0.1:5052

# Redis (optional — dashboard works without it)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
